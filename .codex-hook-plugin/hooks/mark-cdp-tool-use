#!/usr/bin/env bash
# PostToolUse hook wrapper that records Chrome DevTools MCP usage.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

if command -v python >/dev/null 2>&1; then
  exec python "${SCRIPT_DIR}/mark-cdp-tool-use.py"
fi

if command -v python3 >/dev/null 2>&1; then
  exec python3 "${SCRIPT_DIR}/mark-cdp-tool-use.py"
fi

printf '{}\n'
