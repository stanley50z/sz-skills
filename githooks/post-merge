#!/bin/sh
# Re-sync installed skill copies after a successful merge-based pull.
PY=
for candidate in python3 python py; do
    if command -v "$candidate" >/dev/null 2>&1 \
        && "$candidate" -c 'import sys; raise SystemExit(sys.version_info < (3,))' >/dev/null 2>&1; then
        PY=$candidate
        break
    fi
done
if [ -z "$PY" ]; then
    echo "post-merge: no python interpreter found (python3/python/py); skipping re-sync" >&2
    exit 0
fi

echo "post-merge: running setup.py to re-sync installed copies"
cd "$(git rev-parse --show-toplevel)" && "$PY" setup.py
