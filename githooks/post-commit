#!/bin/sh
# Re-sync installed skill copies (notably the ~/.codex/skills copies, which
# unlike the Claude junctions do not track the repo) after commits that touch
# skill or global-instruction sources.
if git diff-tree --no-commit-id --name-only -r HEAD | grep -qE '^(skills/|global/)'; then
    echo "post-commit: skills/global changed, running setup.py to re-sync installed copies"
    PY=
    for candidate in python3 python py; do
        if command -v "$candidate" >/dev/null 2>&1 \
            && "$candidate" -c 'import sys; raise SystemExit(sys.version_info < (3,))' >/dev/null 2>&1; then
            PY=$candidate
            break
        fi
    done
    if [ -z "$PY" ]; then
        echo "post-commit: no python interpreter found (python3/python/py); skipping re-sync" >&2
        exit 0
    fi
    cd "$(git rev-parse --show-toplevel)" && "$PY" setup.py
fi
